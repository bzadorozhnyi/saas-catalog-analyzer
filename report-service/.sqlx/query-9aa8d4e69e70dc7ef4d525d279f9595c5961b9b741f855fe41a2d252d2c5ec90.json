{
  "db_name": "PostgreSQL",
  "query": "\n            UPDATE requests\n            SET status = 'PROCESSING', locked_by = $2, locked_until = $3\n            WHERE id = $1\n              AND (\n                status = 'QUEUED'\n                OR status = 'FAILED'\n                OR (status = 'PROCESSING' AND locked_until < now())\n              )\n            RETURNING\n                id,\n                request_type AS \"request_type: RequestType\",\n                status AS \"status: RequestStatus\",\n                payload,\n                locked_by,\n                locked_until,\n                trace_id,\n                trace_context\n            ",
