AI__OPENAI_API_KEY=sk-...
AI__CLASSIFICATION_MODEL=gpt-4o-mini
AI__EMBEDDING_MODEL=text-embedding-3-small

LOGFIRE_TOKEN=

DB__HOST=localhost
DB__PORT=5432
DB__USER=postgres
DB__PASSWORD=password
DB__NAME=saas_catalog
DB__SSL_MODE=disable

# Local only (LocalStack emulator). Leave all three unset in real AWS
# environments — boto3 resolves the endpoint and credentials (IAM role) itself.
SQS__ENDPOINT_URL=http://localhost:4566
SQS__ACCESS_KEY_ID=test
SQS__SECRET_ACCESS_KEY=test

# Same local-only rule as SQS above; used by report-service to upload PDFs.
S3__ENDPOINT_URL=http://localhost:4566
S3__ACCESS_KEY_ID=test
S3__SECRET_ACCESS_KEY=test
